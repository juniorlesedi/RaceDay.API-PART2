@model List<RaceDay.MVC.Models.RaceEventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">

    <h2 class="text-primary">Event Management</h2>

    <p>Manage RaceDay racing events.</p>

    <div class="mb-4">
        <a asp-controller="Events"
           asp-action="Create"
           class="btn btn-success">
            + Create New Event
        </a>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No events available.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.name</td>
                            <td>@item.description</td>
                            <td>
                                @item.event_date.ToString("dd MMM yyyy")
                            </td>
                            <td>@item.location</td>
                            <td>@item.Distance_km km</td>
                            <td>@item.event_type</td>
                            <td>@item.status</td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.eventID"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.eventID"
                                          method="post"
                                          onsubmit="return confirm('Delete this event?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
