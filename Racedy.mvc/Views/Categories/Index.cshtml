@model List<RaceDay.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    var eventNames = ViewBag.EventNames
        as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="container mt-4">

    <h2 class="text-primary">Category Management</h2>
    <p>View and manage categories for race events.</p>

    <div class="mb-4">
        <a asp-action="Create"
           class="btn btn-success">
            + Create Category
        </a>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No categories found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Category</th>
                        <th>Age Group</th>
                        <th>Gender</th>
                        <th>Distance</th>
                        <th>Max Participants</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @(eventNames.TryGetValue(
                                                        item.eventID, out var eventName)
                                                        ? eventName
                                                        : $"Event {item.eventID}")
                    </td>

                            <td>@item.name</td>
                            <td>@item.agegroup</td>
                            <td>@item.gender</td>
                            <td>@item.distancekm km</td>
                            <td>@item.max_participants</td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.categoryID"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.categoryID"
                                          method="post"
                                          onsubmit="return confirm('Delete this category?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                                }
                </tbody>
            </table>
        </div>
    }
</div>
