@model RaceDay.MVC.Models.CategoryInputViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4">

    <h2 class="text-primary">Edit Category</h2>

    <p>Update the category details.</p>

    <form asp-action="Edit"
          asp-route-id="@ViewBag.CategoryId"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <input asp-for="EventId" type="hidden" />

        <div class="mb-3">
            <label class="form-label">Race Event</label>
            <input class="form-control"
                   value="@ViewBag.EventName"
                   readonly />
            <small class="text-muted">
                A category cannot be moved to another event.
            </small>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Category Name
            </label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AgeGroup" class="form-label">
                Age Group
            </label>
            <input asp-for="AgeGroup" class="form-control" />
            <span asp-validation-for="AgeGroup"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Gender" class="form-label">
                Gender
            </label>
            <select asp-for="Gender" class="form-select">
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Mixed">Mixed</option>
            </select>
            <span asp-validation-for="Gender"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DistanceKm" class="form-label">
                Distance (km)
            </label>
            <input asp-for="DistanceKm"
                   type="number"
                   min="0.01"
                   max="999.99"
                   step="0.01"
                   class="form-control" />
            <span asp-validation-for="DistanceKm"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MaxParticipants" class="form-label">
                Maximum Participants
            </label>
            <input asp-for="MaxParticipants"
                   type="number"
                   min="1"
                   class="form-control" />
            <span asp-validation-for="MaxParticipants"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
