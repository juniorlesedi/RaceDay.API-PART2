@model RaceDay.MVC.Models.CategoryInputViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-4">

    <h2 class="text-primary">Create Category</h2>

    <p>Add a category to an existing race event.</p>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="EventId" class="form-label">
                Race Event
            </label>

            <select asp-for="EventId"
                    asp-items="ViewBag.Events"
                    class="form-select">
                <option value="0">Select an event</option>
            </select>

            <span asp-validation-for="EventId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Category Name
            </label>
            <input asp-for="Name"
                   class="form-control"
                   placeholder="Example: 5km Fun Run" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AgeGroup" class="form-label">
                Age Group
            </label>
            <input asp-for="AgeGroup"
                   class="form-control"
                   placeholder="Example: 18-35" />
            <span asp-validation-for="AgeGroup"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Gender" class="form-label">
                Gender
            </label>
            <select asp-for="Gender" class="form-select">
                <option value="">Select gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Mixed">Mixed</option>
            </select>
            <span asp-validation-for="Gender"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DistanceKm" class="form-label">
                Distance (km)
            </label>
            <input asp-for="DistanceKm"
                   type="number"
                   step="0.01"
                   min="0.01"
                   max="999.99"
                   class="form-control" />
            <span asp-validation-for="DistanceKm"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MaxParticipants" class="form-label">
                Maximum Participants
            </label>
            <input asp-for="MaxParticipants"
                   type="number"
                   min="1"
                   class="form-control" />
            <span asp-validation-for="MaxParticipants"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">
            Create Category
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
